esbuild.js
eslint.config.js
.vscode-test.mjs
.mocharc.json
.prettierrc.json
.prettierignore
tsconfig.json
.gitignore

# Workspace settings written here by integration tests (the test harness
# opens this repo root as the test workspace folder) — never shipped, always
# stale by the time you'd package.
.vscode/**

# Local dev-tooling scratch state (codebase-memory-mcp indexing cache, the
# subagent-driven-development plan workspace) — not sourced from .gitignore
# because vsce does not reliably honor it; list explicitly instead.
.codebase-memory/**
.superpowers/**

docs/**
src/**
test/**

# esbuild bundles src/extension.ts and its dependencies (including
# minimatch/yaml) into dist/extension.js -- the raw tsc output and
# node_modules are only needed for compiling/running tests, never for
# shipping.
out/**
node_modules/**

**/*.map
